# SatInsight AI — Backend Environment Variables
# Copy this file to .env and fill in your values.

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Isolation Forest contamination rate (0.01–0.5)
# 0.05 means the model expects ~5% of rows to be anomalous
ANOMALY_CONTAMINATION=0.05

# Session TTL in seconds (in-memory store)
SESSION_TTL_SECONDS=3600

# Future: NASA API key
# NASA_API_KEY=

# Future: Space-Track.org credentials
# SPACETRACK_USER=
# SPACETRACK_PASS=
